{
  "name": "flowmotion",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven animated architecture diagrams from YAML (SVG-first, Obsidian plugin).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-schema.mjs && node scripts/build.mjs && node scripts/build-monaco.mjs",
    "schema": "node scripts/build-schema.mjs",
    "examples": "tsx scripts/build-examples.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-drawio": "node scripts/fetch-drawio.mjs",
    "install-plugin": "node scripts/install-plugin.mjs",
    "addons": "node scripts/package-addons.mjs",
    "lint": "eslint src",
    "test:e2e": "npm run build && wdio run ./wdio.conf.mts"
  },
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "elkjs": "^0.12.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "happy-dom": "^21.0.4",
    "mocha": "^12.0.3",
    "monaco-editor": "^0.52.2",
    "obsidian": "latest",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "eslint-plugin-n": "^18.5.0",
    "@microsoft/eslint-plugin-sdl": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
