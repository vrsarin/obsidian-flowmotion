{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowMotion diagram",
  "type": "object",
  "required": [
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "description": "Diagram-wide settings.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier used for generated SVG ids.",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "edgeLabels": {
          "type": "boolean",
          "description": "Show each flow's payload as a label on its connector, so the static diagram reads like a flowchart.",
          "default": false
        },
        "direction": {
          "type": "string",
          "enum": [
            "LR",
            "RL",
            "TB",
            "BT"
          ],
          "description": "Layout direction.",
          "default": "LR"
        }
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 200,
      "description": "Boxes that visually contain nodes (like Mermaid subgraphs). Groups can nest.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique group id.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "label": {
            "type": "string",
            "description": "Title shown on the group.",
            "maxLength": 120
          },
          "parent": {
            "type": "string",
            "description": "Id of the group this one sits inside.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "description": "The boxes in the diagram.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique node id.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "label": {
            "type": "string",
            "description": "Text shown in the box (defaults to the id).",
            "maxLength": 120
          },
          "shape": {
            "type": "string",
            "enum": [
              "rect",
              "round",
              "stadium",
              "diamond",
              "circle",
              "cylinder",
              "hexagon",
              "subroutine",
              "parallelogram",
              "start",
              "end",
              "bar",
              "class"
            ],
            "description": "Outline of the node.",
            "default": "rect"
          },
          "group": {
            "type": "string",
            "description": "Id of the group that contains this node.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "lines": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Text lines under the title (class members, attributes, notes)."
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "description": "Colours for this node.",
            "properties": {
              "fill": {
                "type": "string",
                "description": "Background colour, e.g. #e6efff."
              },
              "stroke": {
                "type": "string",
                "description": "Outline / line colour."
              },
              "color": {
                "type": "string",
                "description": "Text colour."
              },
              "strokeWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 12
              }
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 400,
      "description": "Connectors between nodes. Packets travel along flows.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique flow id (referenced by transfer events).",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "from": {
            "type": "string",
            "description": "Source node id.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "x-ref": "node"
          },
          "to": {
            "type": "string",
            "description": "Target node id.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "x-ref": "node"
          },
          "payload": {
            "type": "string",
            "description": "Label carried by the packet.",
            "maxLength": 120
          },
          "line": {
            "type": "string",
            "enum": [
              "solid",
              "dotted",
              "thick"
            ],
            "description": "Line style.",
            "default": "solid"
          },
          "head": {
            "type": "string",
            "enum": [
              "none",
              "arrow",
              "circle",
              "cross",
              "triangle",
              "diamond",
              "diamond-filled"
            ],
            "description": "Decoration at the target end.",
            "default": "arrow"
          },
          "tail": {
            "type": "string",
            "enum": [
              "none",
              "arrow",
              "circle",
              "cross",
              "triangle",
              "diamond",
              "diamond-filled"
            ],
            "description": "Decoration at the source end.",
            "default": "none"
          },
          "headLabel": {
            "type": "string",
            "description": "Small text at the target end, e.g. 1 or 0..*.",
            "maxLength": 20
          },
          "tailLabel": {
            "type": "string",
            "description": "Small text at the source end.",
            "maxLength": 20
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "description": "Colour and width of the line.",
            "properties": {
              "fill": {
                "type": "string",
                "description": "Background colour, e.g. #e6efff."
              },
              "stroke": {
                "type": "string",
                "description": "Outline / line colour."
              },
              "color": {
                "type": "string",
                "description": "Text colour."
              },
              "strokeWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 12
              }
            }
          },
          "curve": {
            "type": "boolean",
            "description": "Draw the connector as a curve (helps avoid overlaps)."
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "description": "The animation script. Events run when everything in `after` is done.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique event id.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "transfer",
              "process",
              "complete",
              "branch",
              "fork",
              "join",
              "wait",
              "emit"
            ],
            "description": "transfer: packet along a flow · process/emit/complete: node activity · wait: node waits for `until` · fork/join: sync points · branch: pick `select` children."
          },
          "flow": {
            "type": "string",
            "description": "transfer: the flow to send a packet along.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "x-ref": "flow"
          },
          "node": {
            "type": "string",
            "description": "process, emit, complete, wait: the node involved.",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "x-ref": "node"
          },
          "payload": {
            "type": "string",
            "description": "Packet label override.",
            "maxLength": 120
          },
          "after": {
            "description": "Event ids that must finish first.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                  "x-ref": "event"
                }
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "x-ref": "event"
              }
            ]
          },
          "until": {
            "description": "wait only: the wait ends when all of these events complete.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                  "x-ref": "event"
                }
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "x-ref": "event"
              }
            ]
          },
          "select": {
            "description": "branch only: the child events that are taken; others are skipped.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                  "x-ref": "event"
                }
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "x-ref": "event"
              }
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 60000,
            "description": "Length in milliseconds."
          },
          "fail": {
            "type": "boolean",
            "description": "process only: the node ends in an error state."
          }
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Playback settings.",
      "properties": {
        "autoplay": {
          "type": "boolean",
          "default": true
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1,
          "description": "Playback speed multiplier."
        }
      }
    },
    "src": {
      "type": "string",
      "pattern": "\\.(flow|ya?ml|json)$",
      "description": "Render a diagram stored in a .flow, .yaml or .json file (path relative to this note, or starting with / for the vault root). Only display options may be set next to it.",
      "examples": [
        "./diagram.yaml"
      ]
    },
    "controls": {
      "type": "boolean",
      "description": "Show the playback control bar from the start."
    },
    "controlsPosition": {
      "type": "string",
      "enum": [
        "top",
        "bottom"
      ],
      "description": "Where the control bar sits.",
      "default": "top"
    },
    "header": {
      "type": "boolean",
      "description": "Storyboards: show the step label above the diagram. Off by default, so the space goes to the diagram.",
      "default": false
    },
    "footer": {
      "type": "boolean",
      "description": "Storyboards: show the caption text below the diagram. Off by default, so the space goes to the diagram.",
      "default": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "fit",
        "normal"
      ],
      "description": "\"fit\" scales the diagram to the available width."
    },
    "paper": {
      "type": "string",
      "description": "draw.io drawings: sheet behind the drawing, or a colour."
    },
    "height": {
      "type": "string",
      "pattern": "^\\d{1,4}(\\.\\d+)?(px|vh)$",
      "description": "Maximum height, e.g. 60vh or 500px.",
      "examples": [
        "60vh",
        "500px"
      ]
    },
    "width": {
      "type": "string",
      "pattern": "^\\d{1,4}(\\.\\d+)?(px|vw|%)$",
      "description": "Maximum width, e.g. 70%, 900px or 80vw. The diagram is centered.",
      "examples": [
        "70%",
        "900px"
      ]
    }
  }
}
